# ProofCrew configuration — copy to .env or export directly. Never commit keys.

# REQUIRED: Nebius Token Factory API key (https://tokenfactory.nebius.com)
TOKENFACTORY_API_KEY=

# REQUIRED: path to an operator-managed unencrypted Ed25519 PKCS#8 PEM key.
PROOFCREW_SIGNING_KEY=

# OPTIONAL: Tavily API key. When set, worker B grounds its part with a live
# Tavily search and its receipt records grounded: true. When unset, no search
# happens and the receipt honestly records grounded: false.
TAVILY_API_KEY=

# OPTIONAL overrides (defaults shown):
# TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_PLANNER=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_WORKER=nvidia/nemotron-3-super-120b-a12b
# MODEL_SCREENER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# PORT=8080
