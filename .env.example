# ProofCrew configuration — copy to .env or export directly. Never commit keys.

# REQUIRED: Nebius Token Factory API key (https://tokenfactory.nebius.com)
TOKENFACTORY_API_KEY=

# OPTIONAL: path to an operator-managed unencrypted Ed25519 PKCS#8 PEM key.
# When unset, runs are clearly marked unsigned.
PROOFCREW_SIGNING_KEY=

# OPTIONAL: Tavily API key. When set, worker B grounds its part with a live
# Tavily search and its receipt records grounded: true. When unset, no search
# happens and the receipt honestly records grounded: false.
TAVILY_API_KEY=

# OPTIONAL overrides (defaults shown):
# TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_PLANNER=nvidia/Nemotron-3-Ultra-550b-a55b
# MODEL_WORKER=nvidia/nemotron-3-super-120b-a12b
# MODEL_SCREENER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# PORT=8080

# OPTIONAL: bind address for app.py. Default is 127.0.0.1 (loopback only).
# HOST=0.0.0.0

# OPTIONAL — required before exposing app.py through any tunnel or proxy:
# operator token for POST /run (the endpoint that spends the API key above).
# When set, every run request must present it, as the X-ProofCrew-Token
# header or the form's token field. When unset, /run accepts only direct
# local requests to a loopback-bound server; forwarded or remote requests
# are refused.
# PROOFCREW_RUN_TOKEN=
